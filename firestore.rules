rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validSubmission(data) {
      return data.keys().hasAll(['title', 'body', 'category', 'ownerUid', 'status', 'createdAt'])
        && data.keys().hasOnly(['title', 'body', 'category', 'ownerUid', 'status', 'createdAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.body is string && data.body.size() > 0 && data.body.size() <= 5000
        && data.category is string && data.category.size() > 0 && data.category.size() <= 50
        && data.ownerUid is string
        && data.status == 'pending'
        && data.createdAt == request.time;
    }

    match /submissions/{submissionId} {
      allow create: if signedIn()
        && validSubmission(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid;
      allow get, list: if signedIn()
        && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      // Moderation writes go through the authenticated callable backend only.
      allow update, delete: if false;
    }
  }
}
